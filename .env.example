# Jira MCP Server Configuration Example
# Copy this file to .env and fill in your details:
#   cp .env.example .env

# Your Jira Cloud or Jira Data Center base URL
JIRA_URL=https://your-domain.atlassian.net

# Your Atlassian account email address (for Jira Cloud) or username (for Jira Server)
JIRA_EMAIL=your-email@example.com

# Your Atlassian API Token generated from:
# https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=your_atlassian_api_token_here

# (Optional) Default Jira username or account ID for 'get_my_jira_tickets' queries
# Leave empty to automatically use currentUser()
JIRA_DEFAULT_USER=
